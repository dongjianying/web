---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

// ============================================================
// 自动发现封面图片（无需手动 import，新增图片自动生效）
// ============================================================
const desktopImages = import.meta.glob<{ default: ImageMetadata }>(
	"@/assets/images/DesktopWallpaper/*.{jpg,jpeg,png,webp,avif}",
	{ eager: true },
);
const mobileImages = import.meta.glob<{ default: ImageMetadata }>(
	"@/assets/images/MobileWallpaper/*.{jpg,jpeg,png,webp,avif}",
	{ eager: true },
);

// 所有可用封面图片池
const allCovers: ImageMetadata[] = [
	...Object.values(desktopImages).map((m) => m.default),
	...Object.values(mobileImages).map((m) => m.default),
];

// ============================================================
// 可选：分类描述配置（只写描述，封面图自动分配）
// 新增笔记本只需在 src/content/posts/ 下建文件夹，无需改这里
// ============================================================
const categoryDescriptions: Record<string, string> = {
	guide: "博客使用指南和教程",
	SC学习笔记: "合成生物学课程学习笔记",
	代码示例: "编程实践中的代码片段和示例",
	合成生物学: "合成生物学相关研究和思考",
	方程式: "数学公式和推导过程",
	杂家摘记: "日常阅读和思考的摘录",
	考研笔记: "考研复习笔记和总结",
	随笔: "生活感悟和随笔记录",
};

// 根据分类名自动匹配封面图（按名称哈希稳定分配，同类名始终同一张图）
function getCoverForCategory(name: string): ImageMetadata {
	// 优先匹配图片文件名（如 “方程式.jpg” 自动匹配 “方程式” 分类）
	for (const [path, mod] of Object.entries({
		...desktopImages,
		...mobileImages,
	})) {
		const fileName =
			path
				.split("/")
				.pop()
				?.replace(/\.[^.]+$/, "") || "";
		if (fileName === name) return mod.default;
	}
	// 否则按名称哈希稳定分配
	let hash = 0;
	for (let i = 0; i < name.length; i++) {
		hash = ((hash << 5) - hash + name.charCodeAt(i)) | 0;
	}
	return allCovers[Math.abs(hash) % allCovers.length];
}

const title = "笔记本";
const description = "按主题整理的文章合集，每一页都是成长的足迹";

// 获取所有文章并按目录分组
const allPosts = await getSortedPosts();

// 按目录分组文章
const groupedPosts: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
	const id = post.id || "";
	const pathWithoutExt = id.replace(/\.(md|mdx|markdown)$/i, "");
	const category = pathWithoutExt.split("/")[0];
	if (!category || category === pathWithoutExt) continue;

	if (!groupedPosts[category]) {
		groupedPosts[category] = [];
	}
	groupedPosts[category].push(post);
}

// 转换为数组并排序
const categories = Object.entries(groupedPosts)
	.map(([name, posts]) => {
		const latestPost = posts.reduce((latest, current) => {
			return new Date(current.data.published) > new Date(latest.data.published)
				? current
				: latest;
		}, posts[0]);

		return {
			name,
			count: posts.length,
			cover: getCoverForCategory(name),
			description: categoryDescriptions[name] || `${name} 相关文章`,
			latestDate: latestPost.data.published.toISOString().split("T")[0],
			posts,
		};
	})
	.sort((a, b) => {
		return new Date(b.latestDate).getTime() - new Date(a.latestDate).getTime();
	});

// 计算总数
const totalCategories = categories.length;
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
const latestUpdate =
	categories.length > 0
		? categories[0].latestDate
		: new Date().toISOString().split("T")[0];
---

<MainGridLayout title={title} description={description}>
  <div class="notebooks-container">
    <!-- 页面标题 -->
    <div class="page-header mb-8">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white shadow-lg">
          <Icon is:inline name="material-symbols:auto-stories-rounded" class="text-[1.75rem]" />
        </div>
        <div class="text-4xl font-bold text-neutral-900 dark:text-neutral-100">
          {title}
        </div>
      </div>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        {description}
      </p>
      
      <!-- 统计信息 -->
      <div class="mt-4 flex items-center gap-6 text-sm text-neutral-500 dark:text-neutral-400">
        <span class="flex items-center gap-2">
          <Icon is:inline name="material-symbols:folder-rounded" class="text-lg" />
          <strong>{totalCategories}</strong> 本
        </span>
        <span class="flex items-center gap-2">
          <Icon is:inline name="material-symbols:description-rounded" class="text-lg" />
          <strong>{totalPosts}</strong> 篇
        </span>
        <span class="flex items-center gap-2">
          <Icon is:inline name="material-symbols:calendar-today-rounded" class="text-lg" />
          {latestUpdate}
        </span>
      </div>
    </div>

    <!-- 笔记本卡片网格 -->
    <div class="notebook-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((category) => (
        <a href={`/posts/notebooks/${encodeURIComponent(category.name)}/`} class="notebook-card group">
          <!-- 封面图 -->
          <div class="notebook-cover relative aspect-video overflow-hidden rounded-t-xl">
            <Image
              src={category.cover}
              alt={category.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80" />
            
            <!-- 文章数量标签 -->
            <div class="absolute top-3 right-3 px-3 py-1 rounded-full bg-white/90 dark:bg-black/80 backdrop-blur-sm text-xs font-semibold text-neutral-800 dark:text-neutral-200 shadow-md">
              {category.count} 篇
            </div>
          </div>
          
          <!-- 内容区域 -->
          <div class="notebook-content p-5 bg-white dark:bg-neutral-800 border-x border-b border-neutral-200 dark:border-neutral-700 rounded-b-xl">
            <div class="flex items-start justify-between mb-2">
              <div class="flex items-center gap-2">
                <Icon is:inline name="material-symbols:menu-book-rounded" class="text-blue-500 text-lg" />
                <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">
                  笔记
                </span>
              </div>
              <span class="text-xs text-neutral-400 dark:text-neutral-500">
                {category.latestDate}
              </span>
            </div>
            
            <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {category.name}
            </h3>
            
            <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
              {category.description}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- 底部提示 -->
    <div class="mt-12 text-center text-sm text-neutral-500 dark:text-neutral-400">
      <p class="flex items-center justify-center gap-2">
        <Icon is:inline name="material-symbols:lightbulb-outline-rounded" class="text-yellow-500" />
        ✨ 每一页都是成长的足迹
      </p>
    </div>
  </div>
</MainGridLayout>

<style>
  .notebook-card {
    display: block;
    border-radius: var(--radius-large);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }
  
  .notebook-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  
  @media (prefers-color-scheme: dark) {
    .notebook-card {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }
    
    .notebook-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
  }
</style>
